Items: {
	testgun: {
		DisplayName: testgun
		Tooltip:
			'''
			Template of an item
			Replacing this tooltip is duty 
			It's snowing on Mt.Fuji
			'''
	}

	diamondsword: {
		DisplayName: Diamond Sword
		Tooltip:
			'''
			Made of shiny blue gems, yet somehow worse than a flaming sword made of hell-metal.
			Did someone bring the wrong game's recipe book to the anvil?
			'''
	}

	corep90: {
		DisplayName: Core-Line P90
		Tooltip:
			'''
			33% chance to save ammo
			It costs $400,000 to fire this weapon... for twelve seconds.
			Wait, wrong gun. This one actually just runs on cheap gunpowder and sheer optimism.
			'''
	}

	photonaccelerator: {
		DisplayName: Photon Accelerator
		Tooltip:
			'''
			25% chance to save ammo
			Upgraded with reinforced alloy and precision servos for only $1,999!
			Dark goggles highly recommended. (Manufacturer is not liable for melted barrels).
			'''
	}

	redlinedvector: {
		DisplayName: Redlined Vector
		Tooltip:
			'''
			25% chance to save ammo
			The engineers said, 'This violates basic safety regulations.'
			So we fired the engineers and added another battery pack. Shoot away!
			'''
	}

	surgearray: {
		DisplayName: Surge Array
		Tooltip:
			'''
			10% chance to save ammo
			[c/FF3333:Efficiency was completely ignored during manufacturing.]
			Congratulations! You hold a portable bullet dispenser.
			Please refrain from shooting the floor, unless you enjoy explaining your severe hearing loss to the doctor.
			'''
	}

	sparknlead: {
		DisplayName: Spark & Lead
		Tooltip:
			'''
			Fires a salvo of lead
			Spreads bullets evenly across a smaller cone
			The engineers spent six months perfecting the spread math.
			'''
	}

	dragkoon: {
		DisplayName: Dragkoon
		Tooltip:
			'''
			Fires a salvo of lead
			Spreads bullets evenly across a smaller cone
			"Is it precise?" Not even a little.
			"Will it hit the target?" Along with the wall, the floor, the trees, and three neighboring postcodes.
			'''
	}

	ArmorReforgeKit: {
		DisplayName: Armor Reforge Kit
		Tooltip: 
			'''
			
			'''
	}

	CustomTerraprisma: {
		DisplayName: Custom Terraprisma
		Tooltip: Dont expect the swords to be in formation.
	}

	havoc: {
		DisplayName: Havoc
		Tooltip: 
			'''
			15% chance to save ammo
			Continuously firing this weapon ramps up its damage, up to 3.0x the base damage.
			Each sustained burst drags the target one step closer to absolute zero.
			'''
	}

	novamalevolence: {
		DisplayName: Nova's Malevolence
		Tooltip: 
			'''
			10% chance to save ammo
			Continuously firing this weapon ramps up its damage, up to 7.5x the base damage.
			Born from an absolute vacuum. It starves the air, swallows the light, and leaves nothing behind.
			'''
	}

	luminosshot: {
		DisplayName: Luminos Shot
		Tooltip: 
			'''
			33% chance to save ammo
			Consumes 5 mana per shot to fire an additional laser that deals 75% of the gun's damage.
			Without mana, it will shoot like a normal gun without the laser.
			Harnesses a concentrated beam of solar radiance.
			'''
	}

	heatflare: {
		DisplayName: Heatflare
		Tooltip: 
			'''
			25% chance to save ammo
			Consumes 10 mana per shot to fire a charged laser beam that deals 150% of the gun's damage.
			Without mana, it will shoot like a normal gun without the laser.
			A contained supernova barrel-wrapped for your convenience.
			'''
	}
}

